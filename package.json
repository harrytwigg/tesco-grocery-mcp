{
  "name": "tesco-grocery-mcp",
  "version": "1.0.0",
  "description": "OpenClaw plugin for Tesco grocery shopping — search products, manage your basket, and book delivery slots",
  "license": "MIT",
  "author": "Gavin Attard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GavinAttard/tesco-grocery-mcp.git"
  },
  "homepage": "https://github.com/GavinAttard/tesco-grocery-mcp#readme",
  "bugs": {
    "url": "https://github.com/GavinAttard/tesco-grocery-mcp/issues"
  },
  "keywords": [
    "openclaw",
    "tesco",
    "grocery",
    "shopping",
    "plugin",
    "ai"
  ],
  "files": [
    "dist/src/",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "type": "module",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "playwright": "^1.52.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
